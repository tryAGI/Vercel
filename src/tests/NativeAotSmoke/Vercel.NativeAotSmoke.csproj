<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <!-- Exercise the complete generated context while limiting native code expansion. -->
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- Match the SDK release build: native debug data is unnecessary for this contract harness. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Avoid pathological post-codegen deduplication for the full SDK on Linux. -->
    <IlcFoldIdenticalMethodBodies Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64'">false</IlcFoldIdenticalMethodBodies>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../libs/Vercel/Vercel.csproj" />
  </ItemGroup>
</Project>
